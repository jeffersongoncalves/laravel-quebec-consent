{
    "name": "jeffersongoncalves/laravel-quebec-consent",
    "description": "Consent for Quebec Law 25: a manifest, free and enlightened consent per specific purpose, versioned, with expiry, withdrawal and proof, for users and visitors",
    "keywords": [
        "laravel",
        "privacy",
        "quebec",
        "law-25",
        "consent"
    ],
    "homepage": "https://github.com/jeffersongoncalves/laravel-quebec-consent",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Jefferson Gonçalves",
            "email": "gerson.simao.92@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0",
        "jeffersongoncalves/laravel-quebec": "^1.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "jeffersongoncalves/pest-plugin-database-migrations": "^1.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "JeffersonGoncalves\\QuebecConsent\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JeffersonGoncalves\\QuebecConsent\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JeffersonGoncalves\\QuebecConsent\\QuebecConsentServiceProvider"
            ],
            "aliases": {
                "QuebecConsent": "JeffersonGoncalves\\QuebecConsent\\Facades\\QuebecConsent"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
